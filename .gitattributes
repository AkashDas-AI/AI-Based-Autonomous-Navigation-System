# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text file types
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.ini text eol=lf

# Binary media and artifact files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.avi binary
*.pdf binary

